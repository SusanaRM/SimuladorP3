{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "node",
    "target": "ES2020",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noImplicitAny": false,
    "types": ["jest"]
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "*.js",
    "../../p3js/src"
  ],
  "exclude": [
    "node_modules"
  ]
}